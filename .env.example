VITE_LUKE_SHOP_API_BASE_URL=http://localhost:4100
# v0.2.1 resolves tenants from /t/{tenantSlug}, /t/{tenantSlug}/s/{storeSlug}, signed preview links, or production hostnames.
# Keep the legacy environment fallback disabled so / never silently opens Demo Store.
VITE_LUKE_SHOP_TENANT_SLUG=
VITE_LUKE_SHOP_STORE_ID=
VITE_LUKE_SHOP_ALLOW_ENV_TENANT_FALLBACK=false
VITE_APP_ENV=development
